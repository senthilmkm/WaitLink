rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'senthil930@gmail.com';
    }

    function isShopOwner(shopData) {
      return isAuthenticated() && (
        (shopData.ownerEmail != null && shopData.ownerEmail == request.auth.token.email) ||
        (shopData.ownerUid != null && shopData.ownerUid == request.auth.uid)
      );
    }

    // Public Customer Queue Action Validator (Prevents malicious array wipes & overwrites)
    function isValidPublicShopUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let hasValidKeys = affectedKeys.hasOnly(['queue', 'history', 'stats', 'updatedAt', 'lastActive']);

      let prevQ = ('queue' in resource.data && resource.data.queue is list) ? resource.data.queue.size() : 0;
      let newQ = ('queue' in request.resource.data && request.resource.data.queue is list) ? request.resource.data.queue.size() : 0;
      let prevH = ('history' in resource.data && resource.data.history is list) ? resource.data.history.size() : 0;
      let newH = ('history' in request.resource.data && request.resource.data.history is list) ? request.resource.data.history.size() : 0;

      let isCheckIn = newQ == prevQ + 1 && newH == prevH;
      let isSelfCancel = newQ == prevQ - 1 && newH == prevH + 1;
      let isLateOrStatusUpdate = newQ == prevQ && newH == prevH;

      return hasValidKeys &&
             ('queue' in request.resource.data && request.resource.data.queue is list) &&
             ('history' in request.resource.data && request.resource.data.history is list) &&
             newQ <= 500 &&
             (newQ + newH >= prevQ + prevH) &&
             (isCheckIn || isSelfCancel || isLateOrStatusUpdate) &&
             (
               !isCheckIn || (
                 request.resource.data.queue[newQ - 1] is map &&
                 request.resource.data.queue[newQ - 1].id is string &&
                 request.resource.data.queue[newQ - 1].customerName is string &&
                 request.resource.data.queue[newQ - 1].customerName.size() >= 1 &&
                 request.resource.data.queue[newQ - 1].customerName.size() <= 100 &&
                 request.resource.data.queue[newQ - 1].checkedInAt is number &&
                 (prevQ == 0 || request.resource.data.queue[0].id == resource.data.queue[0].id)
               )
             ) &&
             (
               !isLateOrStatusUpdate || (
                 prevQ == 0 || request.resource.data.queue[0].id == resource.data.queue[0].id
               )
             );
    }

    // 1. Shops Collection (Multi-Tenant Queues & Settings)
    match /shops/{shopId} {
      // Anyone can read a single shop doc (public wait times and queue display)
      allow get: if true;
      
      // Listing/querying across shops is restricted to SuperAdmin or authenticated owners
      allow list: if isSuperAdmin() || isAuthenticated();

      // Create new shop: authenticated users (defaulting to Starter plan) or SuperAdmin
      allow create: if isSuperAdmin() || (
        isAuthenticated() &&
        request.resource.data.shopName is string &&
        request.resource.data.slug is string &&
        (!('planPrice' in request.resource.data) || request.resource.data.planPrice == 0)
      );

      // Update shop: SuperAdmin, Shop Owner (locked from changing pricing), or validated public customer check-in
      allow update: if isSuperAdmin() || (
        isShopOwner(resource.data) &&
        // Shop owners cannot directly alter planPrice, planTitle, or Stripe credentials from the client SDK
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'planPrice', 'planTitle', 'subscriptionStatus', 'stripeCustomerId', 'stripeSessionId'
        ])
      ) || (
        // Restrict public customer self-checkin, self-cancel, and delay reporting
        // Hardens against malicious queue wiping or array overwriting (P0 Security)
        isValidPublicShopUpdate()
      );

      // Delete shop: SuperAdmin only
      allow delete: if isSuperAdmin();

      // Step 3: Queue History Subcollection (Tier-retained visit records)
      match /history/{ticketId} {
        allow read, write: if isSuperAdmin() || (
          isAuthenticated() && (
            isShopOwner(get(/databases/$(database)/documents/shops/$(shopId)).data)
          )
        );
      }
    }

    // 2. Outbound SMS Messages (Twilio Extension Trigger Queue)
    match /messages/{messageId} {
      // Outbound SMS message creation requires authentication
      allow create: if isSuperAdmin() || (isAuthenticated() && request.resource.data.to is string && request.resource.data.body is string);
      // Nobody on the public web can read, list, update, or delete SMS records
      allow read, update, delete: if isSuperAdmin();
    }

    // 3. Contact Support Inquiries
    match /contact_messages/{msgId} {
      // Anyone on contact.html can submit a support message
      allow create: if request.resource.data.email is string &&
                       request.resource.data.name is string &&
                       request.resource.data.message is string;
      // Only SuperAdmin can read, list, reply to, or delete support inquiries
      allow read, update, delete: if isSuperAdmin();
    }

    // 4. Support Replies
    match /support_replies/{replyId} {
      allow read, write: if isSuperAdmin();
    }

    // 5. Global Settings & Pricing Config
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 6. Pricing Audit Logs
    match /pricing_audits/{auditId} {
      allow read, write: if isSuperAdmin();
    }

    // 7. Users & Stripe Checkout Subcollections
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;

      match /checkout_sessions/{sessionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
      match /subscriptions/{subscriptionId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow write: if false; // Only written by Stripe webhook / extension
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
