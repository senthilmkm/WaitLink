{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "DESIGN_SPEC.md",
      "README.md",
      "stripe_credentials.json",
      "config.secrets.js",
      "functions/**",
      "jumpin/service.js",
      "jumpin/handlers.js",
      "tests/**",
      "scripts/**",
      "docs/**",
      "scratch/**",
      "waitlinkarchitecture.html",
      "pricing-strategy-roadmap.html"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          }
        ]
      },
      {
        "source": "robots.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "manifest.@(json|webmanifest)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/waitarchitecture.html",
        "destination": "/waitlinkarchitecture.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/carpoolPostRide",
        "function": { "functionId": "carpoolPostRide", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolReserveSeat",
        "function": { "functionId": "carpoolReserveSeat", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolUpdateSeat",
        "function": { "functionId": "carpoolUpdateSeat", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolCancelSeat",
        "function": { "functionId": "carpoolCancelSeat", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolCancelTrip",
        "function": { "functionId": "carpoolCancelTrip", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolCompleteTrip",
        "function": { "functionId": "carpoolCompleteTrip", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolAckRider",
        "function": { "functionId": "carpoolAckRider", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolSendManageLink",
        "function": { "functionId": "carpoolSendManageLink", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolPostMessage",
        "function": { "functionId": "carpoolPostMessage", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolListPending",
        "function": { "functionId": "carpoolListPending", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolReviewRide",
        "function": { "functionId": "carpoolReviewRide", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolAdminCancelTrip",
        "function": { "functionId": "carpoolAdminCancelTrip", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolAdminSetPosting",
        "function": { "functionId": "carpoolAdminSetPosting", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolAdminSetMembers",
        "function": { "functionId": "carpoolAdminSetMembers", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolAdminSaveConfig",
        "function": { "functionId": "carpoolAdminSaveConfig", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolAdminPurge",
        "function": { "functionId": "carpoolAdminPurge", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolAdminBroadcast",
        "function": { "functionId": "carpoolAdminBroadcast", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolCreateGroup",
        "function": { "functionId": "carpoolCreateGroup", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolListGroups",
        "function": { "functionId": "carpoolListGroups", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolReviewGroup",
        "function": { "functionId": "carpoolReviewGroup", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolAdminSavePlatformConfig",
        "function": { "functionId": "carpoolAdminSavePlatformConfig", "region": "us-central1" }
      },
      {
        "source": "/api/carpoolAdminSearchMembers",
        "function": { "functionId": "carpoolAdminSearchMembers", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
